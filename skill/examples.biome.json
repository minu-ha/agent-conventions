{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"root": true,
	"extends": [
		"./typescript/examples/tooling-configure-biome-to-enforce-these-rules/01-correct.json"
	],
	"plugins": [
		"./typescript/examples/tooling-configure-biome-to-enforce-these-rules/02-correct-2.grit"
	],
	"files": {
		"includes": [
			"**/examples/**/*-correct*.ts",
			"**/examples/**/*-correct*.tsx",
			"**/examples/**/*-correct*.js",
			"**/examples/**/*-correct*.json",
			"!**/composition-render-one-branch-with-and/02-correct.tsx",
			"!**/composition-render-one-branch-with-and/04-correct.tsx",
			"!**/composition-render-one-branch-with-and/07-correct.tsx",
			"!**/composition-use-activity-only-to-preserve-mounted-subtrees/02-correct.tsx",
			"!**/composition-use-activity-only-to-preserve-mounted-subtrees/04-correct-2.tsx",
			"!**/perf-defer-heavy-renders-with-measured-evidence/04-correct.tsx",
			"!**/perf-defer-heavy-renders-with-measured-evidence/05-correct.tsx",
			"!**/runtime-avoid-ad-hoc-loading-branches/02-correct.tsx",
			"!**/runtime-avoid-ad-hoc-loading-branches/04-correct.tsx",
			"!**/runtime-avoid-ad-hoc-loading-branches/05-correct.tsx",
			"!**/runtime-place-error-boundaries-by-blast-radius/02-correct.tsx",
			"!**/runtime-place-suspense-boundaries-at-the-section-owner/02-correct.tsx",
			"!**/state-calculate-derived-values-during-render/02-correct.tsx",
			"!**/absence-do-not-guard-what-types-guarantee/04-correct.ts",
			"!**/absence-check-once-at-the-boundary/04-correct.tsx"
		]
	},
	"overrides": [
		{
			"includes": [
				"**/examples/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"noUnusedFunctionParameters": "off"
					},
					"suspicious": {
						"noRedeclare": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/tooling-*/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		}
	]
}
