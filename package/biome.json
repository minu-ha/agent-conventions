{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {"enabled": false, "clientKind": "git", "useIgnoreFile": true},
	"files": {"ignoreUnknown": false, "includes": ["src/**/*.ts", "test/**/*.ts", "*.json", "*.md"]},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {"noUndeclaredVariables": "off", "noUnusedImports": "warn"},
			"style": {"noNonNullAssertion": "off", "useConsistentArrayType": {"level": "warn", "options": {"syntax": "shorthand"}}},
			"suspicious": {"noExtraNonNullAssertion": "warn", "noShadowRestrictedNames": "off"},
			"complexity": {"noUselessConstructor": "warn", "noForEach": "off", "useLiteralKeys": "off"}
		}
	},
	"assist": {"actions": {"source": {"organizeImports": "off"}}},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 140,
		"attributePosition": "auto",
		"bracketSpacing": false,
		"bracketSameLine": false,
		"expand": "never"
	},
	"javascript": {"formatter": {"quoteStyle": "double", "arrowParentheses": "always"}},
	"json": {"parser": {"allowComments": true, "allowTrailingCommas": true}}
}
