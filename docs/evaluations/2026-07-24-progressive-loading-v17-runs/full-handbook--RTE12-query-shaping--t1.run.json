  "virtualPatch": {
    "files": [
      {
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api entry 목록 조회 API\n   */\n  const responseEntriesQuery = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({\n        id: entry.id,\n        label: entry.title.trim(),\n      })),\n      meta: {total: response.total},\n    }),\n  });\n  /**\n   * @api entry 생성 API\n   */\n  const mutationCreateEntry = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntriesQuery.data.items}\n      total={responseEntriesQuery.data.meta.total}\n      onCreate={mutationCreateEntry.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:cd9b0bf05c40a923fd0797668cac1904820321a2aa3c203d05bc2739f52bf1d6",
        "afterState": "present",
        "beforeSha256": "sha256:d4fb4cd10a6cf8d4185cb19a49a86a500e2bc9e48ef0faeb6f0cd04250d3d800",
        "beforeState": "present",
        "path": "src/routes/entries/page.tsx"
      }
    ],
    "summary": "렌더 시점의 entries/items/meta 가공을 query select로 옮기고 binding과 원본 체이닝을 정리했다."
  }
