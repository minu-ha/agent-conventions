  "scenarioId": "RTE10-derived-selection-state",
  "scenarioPrompt": "extract the inline selection toggle into a named handleSelectionToggle handler, replace selectedIds-derived count and flag effect+state synchronization with render calculation near use, and use a functional updater; do not change navigation or styling.",
  "scenarioSha256": "sha256:a685f5de3d76a3dae5a36609e864980e112b866347e8e3ec3110e89a8b01fd0e",
