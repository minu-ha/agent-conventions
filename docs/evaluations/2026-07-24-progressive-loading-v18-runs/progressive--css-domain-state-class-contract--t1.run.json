        "after": "import clsx from \"clsx\";\nimport \"./_index.css\";\n\ninterface CatalogEntry {\n  id: string;\n  label: string;\n  active: boolean;\n}\n\nexport const CatalogPage = ({entries}: {entries: CatalogEntry[]}) => (\n  <nav className=\"route_catalog\">\n    {entries.map((entry) => (\n      <button\n        key={entry.id}\n        className={clsx(\"route_catalog__listButton\", {\n          \"route_catalog__listButton--active\": entry.active,\n        })}\n      >\n        {entry.label}\n      </button>\n    ))}\n  </nav>\n);\n",
