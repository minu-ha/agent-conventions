  "virtualPatch": {
    "files": [
      {
        "path": "src/routes/entries/page.tsx",
        "beforeState": "present",
        "beforeSha256": "sha256:d4fb4cd10a6cf8d4185cb19a49a86a500e2bc9e48ef0faeb6f0cd04250d3d800",
        "afterState": "present",
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api entry 목록 렌더링 응답\n   */\n  const responseEntries = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({id: entry.id, label: entry.title.trim()})),\n      total: response.total,\n    }),\n  });\n  /**\n   * @api entry 생성 요청\n   */\n  const mutationCreateEntry = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntries.data.items}\n      total={responseEntries.data.total}\n      onCreate={mutationCreateEntry.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:438350a2cfb5bac871fe34be93e2cd910c0805dad75bb84e66bb87097aeb78f8"
      }
    ],
    "summary": "반복 렌더 shaping을 query select로 이동하고 response/mutation origin naming과 직접 체이닝을 적용했다."
  }
