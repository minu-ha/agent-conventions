        "after": "import clsx from \"clsx\";\n\n/**\n * @summary route-local entry tree props\n */\ninterface EntryTreeProps {\n  /**\n   * @field 렌더링할 entry 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 entry ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:c14acbf9fd98831e977012a75b447e8b8d9933afaceb18464db6720d98a336fa"
      }
    ],
    "summary": "route 전용 tree renderer를 shared UI에서 entries route의 -local 경계로 옮기고 route-local 이름과 props 수신 형식만 정리했으며 className과 clsx import는 그대로 유지했다."
