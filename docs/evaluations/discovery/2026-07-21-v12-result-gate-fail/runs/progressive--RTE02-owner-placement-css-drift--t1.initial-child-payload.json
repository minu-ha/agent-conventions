        "after": "import clsx from \"clsx\";\n\n/**\n * @summary route 전용 항목 트리 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 트리에 표시할 항목 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 항목 식별자\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:290d4d805f44625850982ab60b42d8fd9a73e5118835f92ea7aaba6b7146df9a"
      }
    ],
    "summary": "route 전용 트리 렌더러를 UI 레이어에서 entries route의 -local 소유 경계로 옮기고 route-local 이름으로 변경했으며, clsx import와 className 표현은 그대로 유지했다."
