        "after": "import clsx from \"clsx\";\n\nimport \"./entry-tree.css\";\n\n/**\n * @summary route 전용 entry tree props 계약\n */\ninterface EntryTreeProps {\n  /**\n   * @field tree에 표시할 entry 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 entry ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul\n      className={clsx(\n        \"rt_entriesEntryTree__list\",\n        selectedId && \"rt_entriesEntryTree__list--selected\",\n      )}\n    >\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
