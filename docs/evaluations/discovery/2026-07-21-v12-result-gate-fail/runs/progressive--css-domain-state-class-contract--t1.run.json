        "after": "import clsx from \"clsx\";\n\nimport \"./_index.css\";\n\ninterface CatalogEntry {\n  id: string;\n  label: string;\n  active: boolean;\n}\n\nexport const CatalogPage = ({entries}: {entries: CatalogEntry[]}) => (\n  <nav className=\"route_catalog\">\n    {entries.map((entry) => (\n      <button\n        key={entry.id}\n        className={clsx(\n          \"route_catalog__listButton\",\n          entry.active && \"route_catalog__listButton--active\",\n        )}\n      >\n        {entry.label}\n      </button>\n    ))}\n  </nav>\n);\n",
        "afterSha256": "sha256:276764ee1ef2bd64f79956a3b0db957ee568d31264e77812ef6c68acd382b1e3",
        "afterState": "present",
        "beforeSha256": "sha256:abb019ed5a3c45ab86dfa1ffee120ac20468d10e0d9489ba5b237b9a8ef31d94",
        "beforeState": "present",
        "path": "src/routes/catalog/index.tsx"
      },
      {
        "after": ".route_catalog__listButton {\n  display: flex;\n}\n\n.route_catalog__listButton--active {\n  color: var(--color-accent);\n  font-weight: 700;\n\n  &:hover {\n    text-decoration: underline;\n  }\n}\n",
        "afterSha256": "sha256:af258d316a26d2690da961b29de09ba8be2ed404712559226ee0338608c1aaf6",
        "afterState": "present",
        "beforeSha256": "sha256:380447b980dedb2ae1260f1fb22e0ab14ddaf07d1a4a9a3a013e784501262bf7",
        "beforeState": "present",
        "path": "src/routes/catalog/_index.css"
