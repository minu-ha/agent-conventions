        "after": "import {useState} from \"react\";\nimport type {MouseEventHandler} from \"react\";\n\ninterface Entry {\n  id: string;\n  label: string;\n}\n\nexport const EntriesPage = ({entries}: {entries: Entry[]}) => {\n  const [selectedIds, setSelectedIds] = useState<string[]>([]);\n\n  /**\n   * @event 선택 항목 토글\n   */\n  const handleSelectionToggle =\n    (entryId: string): MouseEventHandler<HTMLButtonElement> =>\n    (_event) => {\n      setSelectedIds((currentSelectedIds) =>\n        currentSelectedIds.includes(entryId)\n          ? currentSelectedIds.filter((selectedId) => selectedId !== entryId)\n          : [...currentSelectedIds, entryId],\n      );\n    };\n\n  return (\n    <section>\n      <p>\n        {selectedIds.length > 0\n          ? `${selectedIds.length} selected`\n          : \"No selection\"}\n      </p>\n      {entries.map((entry) => (\n        <button\n          key={entry.id}\n          onClick={handleSelectionToggle(entry.id)}\n        >\n          {entry.label}\n        </button>\n      ))}\n    </section>\n  );\n};\n",
        "afterSha256": "sha256:8e5abeed7723572a38de45ee4caebc87bfd719c370e6d35fcbac4c889eb7cdb2"
      }
    ],
