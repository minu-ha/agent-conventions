  "virtualPatch": {
    "files": [
      {
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api 엔트리 목록 조회 API\n   */\n  const responseEntries = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({id: entry.id, label: entry.title.trim()})),\n      total: response.total,\n    }),\n  });\n  /**\n   * @api 엔트리 생성 API\n   */\n  const mutationCreateEntry = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntries.data.items}\n      total={responseEntries.data.total}\n      onCreate={mutationCreateEntry.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:8be5f1b67ecac04247a343432542ca24fbdc8c9f1d9dd152072cfda1d46a3679",
        "afterState": "present",
        "beforeSha256": "sha256:d4fb4cd10a6cf8d4185cb19a49a86a500e2bc9e48ef0faeb6f0cd04250d3d800",
        "beforeState": "present",
        "path": "src/routes/entries/page.tsx"
      }
    ],
    "summary": "렌더 단계의 entries/items/meta 별칭과 가공을 query select로 옮기고 query·mutation binding 및 소비부를 convention에 맞췄다."
  }
