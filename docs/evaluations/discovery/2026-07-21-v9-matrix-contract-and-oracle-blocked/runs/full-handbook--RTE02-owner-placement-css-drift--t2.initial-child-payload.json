        "after": "import clsx from \"clsx\";\n\n/**\n * @summary entries route 전용 tree props\n */\ninterface EntryTreeProps {\n  /**\n   * @field 표시할 entry 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 entry ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:92479b0cbe72df9678a2519208b6781d9419a75b69c7a28d831a7b792548f742"
      }
    ],
    "summary": "route-only tree renderer를 shared UI에서 entries route의 -local 소유로 이동하고 컴포넌트와 props 이름을 route-local 형태로 변경했다. 스타일 계약은 요청대로 유지했다."
