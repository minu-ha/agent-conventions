        "after": "import clsx from \"clsx\";\n\n/**\n * @summary 엔트리 트리 컴포넌트 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 트리에 표시할 엔트리 목록\n   */\n  entries: Array<{\n    /**\n     * @field 엔트리 식별자\n     */\n    id: string;\n    /**\n     * @field 엔트리 표시 이름\n     */\n    label: string;\n  }>;\n  /**\n   * @field 선택된 엔트리 식별자\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = ({entries, selectedId}: EntryTreeProps) => (\n  <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n    {entries.map((entry) => (\n      <li key={entry.id}>{entry.label}</li>\n    ))}\n  </ul>\n);\n",
        "afterSha256": "sha256:7bd6ffc826f03f870740e67f58721be353a9d8c33dc7dd038670ae8474be0982"
      }
    ],
    "summary": "Move the route-only tree renderer into the entries route -local directory, rename it from UiEntryTree to EntryTree, document its custom props shape, and preserve the existing class contract and rendered styling."
  },
