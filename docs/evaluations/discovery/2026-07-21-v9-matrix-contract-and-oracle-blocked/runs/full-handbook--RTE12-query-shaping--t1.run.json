  "virtualPatch": {
    "files": [
      {
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api entry 목록 조회 API\n   */\n  const responseEntriesQuery = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({id: entry.id, label: entry.title.trim()})),\n      total: response.total,\n    }),\n  });\n  /**\n   * @api entry 생성 API\n   */\n  const mutationEntryCreate = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntriesQuery.data.items}\n      total={responseEntriesQuery.data.total}\n      onCreate={mutationEntryCreate.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:4395689350013785160c4734ecb26d7019b434397a4c592f2d41cb2b27ac7e29",
        "afterState": "present",
        "beforeSha256": "sha256:d4fb4cd10a6cf8d4185cb19a49a86a500e2bc9e48ef0faeb6f0cd04250d3d800",
        "beforeState": "present",
        "path": "src/routes/entries/page.tsx"
      }
    ],
    "summary": "Render-scope list, items, and meta aliases are replaced by a query select result, with response... and mutation... bindings and direct response chaining."
  }
