        "afterState": "present",
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api entry 목록 조회 API\n   */\n  const responseEntriesQuery = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({\n        id: entry.id,\n        label: entry.title.trim(),\n      })),\n      total: response.total,\n    }),\n  });\n\n  /**\n   * @api entry 생성 API\n   */\n  const mutationCreateEntry = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntriesQuery.data.items}\n      total={responseEntriesQuery.data.total}\n      onCreate={mutationCreateEntry.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:f778c2f265aa68e803902ac5e9c6f0410dfe711825d498e16d03d5dfc0d3387f"
      }
    ],
    "summary": "React Query select에서 렌더용 items와 total을 한 번 shape하고 response/mutation binding 및 원본 체이닝 규칙을 적용한다."
  }
