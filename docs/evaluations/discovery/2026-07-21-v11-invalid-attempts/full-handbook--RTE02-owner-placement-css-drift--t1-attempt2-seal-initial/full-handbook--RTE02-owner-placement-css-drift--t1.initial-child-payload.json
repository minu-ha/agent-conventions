        "afterState": "present",
        "after": "import clsx from \"clsx\";\n\n/**\n * @summary entries route-local tree props\n */\ninterface EntryTreeProps {\n  /**\n   * @field tree에 표시할 entry 목록\n   */\n  entries: Array<{\n    /**\n     * @field entry ID\n     */\n    id: string;\n    /**\n     * @field entry 표시 이름\n     */\n    label: string;\n  }>;\n  /**\n   * @field 선택된 entry ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:6df0b8252bb1f3cc8258c33060ebb47a6fc65fd2f23282044e5185acdc365f95"
      }
    ],
    "summary": "route-only UiEntryTree를 entries route의 -local 소유로 이동하고 EntryTree로 이름을 바꿨다. 기존 clsx import와 className 문자열은 그대로 유지했으며 styling surface는 변경하지 않았다."
