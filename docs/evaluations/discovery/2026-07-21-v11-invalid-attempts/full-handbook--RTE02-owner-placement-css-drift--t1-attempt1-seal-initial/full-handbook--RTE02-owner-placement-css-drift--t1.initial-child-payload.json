        "after": "import clsx from \"clsx\";\n\n/**\n * @summary 라우트 전용 엔트리 트리 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 렌더링할 엔트리 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 엔트리 ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:9ad696d85ec45097243a2456ba85a8385c8dbdee687c595b101f74573a7d81a9"
      }
    ],
    "summary": "공용 UI의 route-only 트리 렌더러를 entries 라우트의 -local 소유로 이동하고 Ui 접두사를 제거했다. 기존 className 표현은 그대로 유지했으며 제공된 before state에 style import가 없어 그 부재도 유지했다."
  },
