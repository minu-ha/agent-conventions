{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"node <<'NODE'\nconst fs = require('fs');\nconst crypto = require('crypto');\nconst path = 'docs/evaluations/2026-07-21-progressive-loading-v11-runs/full-handbook--RTE03-route-support-extraction--t1.child-payload.json';\nconst payload = JSON.parse(fs.readFileSync(path, 'utf8'));\nconst assert = (condition, message) => { if (\"'!condition) throw new Error(message); };\nconst exactKeys = (object, keys, label) => {\n  assert(JSON.stringify(Object.keys(object).sort()) === JSON.stringify([...keys].sort()), `${label} keys`);\n};\nconst topKeys = ['\"'runtime','declaredLoadedFiles','activatedSkills','receipts','routingTrace','driftReceipt','semanticVerdicts','completion','limitations','response','virtualPatch'];\nexactKeys(payload, topKeys, 'top-level');\nassert(JSON.stringify(payload.activatedSkills) === JSON.stringify(['react','typescript']), 'activatedSkills');\nassert(JSON.stringify(payload.declaredLoadedFiles.paths) === JSON.stringify(['skill/react/SKILL.md','skill/react/AGENTS.md','skill/typescript/SKILL.md','skill/typescript/AGENTS.md']), 'declared paths');\nconst expectedDigests = {\n  react: 'sha256:f229054372cd355e6ca0a1828ecc98cb0341ab33f72a3a087591125e6d6f685b',\n  typescript: 'sha256:f72208d0e31d3fe580300782d0e3c7eb1341339c911149a44789546076799f09',\n};\nconst passes = payload.routingTrace.passes;\nassert(passes.length >= 3, 'pass count');\nfor (let index = 0; index < passes.length; index += 1) {\n  const pass = passes[index];\n  assert(pass.pass === index + 1, \"'`pass sequence ${index + 1}`);\n  assert(JSON.stringify(pass.activatedSkills) === JSON.stringify(payload.activatedSkills), `activation ${pass.pass}`);\n  assert(JSON.stringify(pass.generatedIndexDigests) === JSON.stringify(expectedDigests), `digests ${pass.pass}`);\n  for (const skill of payload.activatedSkills) {\n    const values = [...pass.selected[skill], ...pass.notApplicable[skill], ...pass.unknown[skill]];\n    const expectedCount = skill === '\"'react' ? 42 : 22;\n    assert(values.length === expectedCount && new Set(values).size === expectedCount, \"'`partition ${pass.pass} ${skill}`);\n    if (index > 0) {\n      const previousSelected = new Set(passes[index - 1].selected[skill]);\n      assert([...previousSelected].every((id) => pass.selected[skill].includes(id)), `selected monotonic ${pass.pass} ${skill}`);\n    }\n  }\n  if (index > 0) {\n    const priorEvidence = passes[index - 1].scopeEvidence;\n    assert(priorEvidence.every((value, position) => pass.scopeEvidence[position] === value), `scope evidence append-only ${pass.pass}`);\n  }\n  const status = (ref) => {\n    const [skill, id] = ref.split('\"'/');\n    if (\"'!pass.activatedSkills.includes(skill)) return '\"'INACTIVE';\n    if (pass.selected[skill].includes(id)) return 'Selected';\n    if (pass.notApplicable[skill].includes(id)) return 'N/A';\n    if (pass.unknown[skill].includes(id)) return 'Unknown';\n    throw new Error(\"'`missing target ${ref}`);\n  };\n  for (const edge of pass.reviewWithReevaluated) {\n    assert(edge.outcome === status(edge.target), `review outcome ${pass.pass} ${edge.source} -> ${edge.target}`);\n  }\n}\nconst [leftNumber, rightNumber] = payload.routingTrace.stablePair;\nconst left = structuredClone(passes[leftNumber - 1]);\nconst right = structuredClone(passes[rightNumber - 1]);\nleft.pass = 0;\nright.pass = 0;\nassert(JSON.stringify(left) === JSON.stringify(right), '\"'stable pair state');\nassert(passes[leftNumber - 1].requiresSelectedAdded.length === 0 && passes[rightNumber - 1].requiresSelectedAdded.length === 0, 'stable mandatory delta');\nassert(passes[leftNumber - 1].completionGateAdded.length === 0 && passes[rightNumber - 1].completionGateAdded.length === 0, 'stable gate delta');\nconst finalPass = passes.at(-1);\nassert(payload.activatedSkills.every((skill) => finalPass.unknown[skill].length === 0), 'final unknown');\nfor (const receipt of payload.receipts) {\n  assert(receipt.indexDigest === null && receipt.expanded.length === 0 && receipt.unknown.length === 0, \"'`full-handbook receipt ${receipt.skill}`);\n  assert(JSON.stringify(receipt.selected.map(({id}) => id)) === JSON.stringify(finalPass.selected[receipt.skill]), `receipt selected ${receipt.skill}`);\n  assert(JSON.stringify(receipt.notApplicable.map(({id}) => id)) === JSON.stringify(finalPass.notApplicable[receipt.skill]), `receipt N/A ${receipt.skill}`);\n  const excluded = receipt.excludedGroups.flatMap(({ordinals, reason}) => { assert(reason.length > 0, `exclusion reason ${receipt.skill}`); return ordinals; });\n  assert(JSON.stringify(excluded) === JSON.stringify(receipt.notApplicable.map(({ordinal}) => ordinal)), `excluded union ${receipt.skill}`);\n}\nassert(payload.completion.status === '\"'COMPLETE' && payload.completion.blocked === false, 'completion status');\nassert(payload.completion.coverageFailCount === 0 && payload.completion.semanticFailCount === 0 && payload.completion.unknownCount === 0, 'completion counts');\nassert(payload.virtualPatch.files.length === 2, 'virtual files');\nfor (const file of payload.virtualPatch.files) {\n  const digest = file.after === null ? null : \"'`sha256:${crypto.createHash('\"'sha256').update(file.after, 'utf8').digest('hex')}\"'`;\n  assert(digest === file.afterSha256, `after digest ${file.path}`);\n}\nconsole.log(`VALID: JSON parsed; ${passes.length} routing passes; stable pair ${leftNumber}-${rightNumber}; receipts and 2 virtual hashes verified`);\nNODE'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
