an;\\n}\\n\\nconst createEntryPayload = (\\n  entryId: string,\\n  name: string,\\n  tags: string[],\\n  enabled: boolean,\\n): CreateEntryPayload => ({\\n  entryId,\\n  name: name.trim(),\\n  tags,\\n  enabled,\\n});\\n\\nexport const EntriesPage = () => {\\n  const payload = createEntryPayload(\\\"entry-1\\\", \\\"Draft\\\", [\\\"new\\\"], true);\\n\\n  return <pre>{JSON.stringify(payload)}</pre>;\\n};\\n\",\n      \"path\": \"src/routes/entries/page.tsx\",\n      \"sha256\": \"sha256:4d2d48e8f917a4e7c5d84cac9c5a651f002837d6b3e91b72f8e200d6cdedeb38\",\n      \"state\": \"present\"\n    },\n    {\n      \"content\": null,\n      \"path\": \"src/routes/entries/page.ts\",\n      \"sha256\": null,\n      \"state\": \"absent\"\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
