    "files": [
      {
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api entry 목록 조회 API\n   */\n  const responseEntries = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({id: entry.id, label: entry.title.trim()})),\n      meta: {total: response.total},\n    }),\n  });\n  /**\n   * @api entry 생성 API\n   */\n  const mutationEntry = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntries.data.items}\n      total={responseEntries.data.meta.total}\n      onCreate={mutationEntry.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:69f0a2b731d585ff768ad83136af580fcf0746d2649de6a5af031d308eb6cf9d",
        "afterState": "present",
        "beforeSha256": "sha256:d4fb4cd10a6cf8d4185cb19a49a86a500e2bc9e48ef0faeb6f0cd04250d3d800",
        "beforeState": "present",
        "path": "src/routes/entries/page.tsx"
      }
    ],
    "summary": "Move entry list and meta shaping into query select, rename query and mutation bindings, and remove wide render aliases."
  }
