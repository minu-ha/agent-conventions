        "beforeState": "present",
        "path": "src/routes/catalog/index.tsx"
      },
      {
        "after": ".route_catalog__listButton {\n  display: flex;\n\n  &:hover {\n    text-decoration: underline;\n  }\n}\n\n.route_catalog__listButton--active {\n  color: var(--color-accent);\n  font-weight: 700;\n}\n",
        "afterSha256": "sha256:5f379e7937d74b782e26da3a2d8a8ff640326e9809a357ed81eda602ca59e052",
        "afterState": "present",
