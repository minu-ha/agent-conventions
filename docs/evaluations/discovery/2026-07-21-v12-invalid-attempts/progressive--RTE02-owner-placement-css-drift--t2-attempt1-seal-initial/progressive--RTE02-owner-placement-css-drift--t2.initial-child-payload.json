        "after": "import clsx from \"clsx\";\n\n/**\n * @summary 엔트리 경로 전용 트리 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 트리에 표시할 엔트리 목록\n   */\n  entries: Array<{\n    /**\n     * @field 엔트리 식별자\n     */\n    id: string;\n    /**\n     * @field 엔트리 표시 이름\n     */\n    label: string;\n  }>;\n  /**\n   * @field 선택된 엔트리 식별자\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:9f1d3b315157e152a68550ec1b9e3950f4cd39ca6ba389962a5338a9f182d75e"
      }
    ],
