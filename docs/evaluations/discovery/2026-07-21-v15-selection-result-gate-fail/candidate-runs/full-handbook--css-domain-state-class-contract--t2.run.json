        "after": "import clsx from \"clsx\";\nimport \"./_index.css\";\n\ninterface CatalogEntry {\n  id: string;\n  label: string;\n  active: boolean;\n}\n\nexport const CatalogPage = ({entries}: {entries: CatalogEntry[]}) => (\n  <nav className=\"route_catalog\">\n    {entries.map((entry) => (\n      <button\n        key={entry.id}\n        className={clsx(\"route_catalog__listButton\", entry.active && \"route_catalog__listButton--active\")}\n      >\n        {entry.label}\n      </button>\n    ))}\n  </nav>\n);\n",
        "afterSha256": "sha256:95a5dc1f80e9dd7863adef54c7d7a8e02e6b5db0a68d9cd8e2146b3dc2a1240a",
