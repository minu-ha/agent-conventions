        "afterState": "present",
        "after": "import {useState} from \"react\";\nimport type {MouseEventHandler} from \"react\";\n\ninterface Entry {\n  id: string;\n  label: string;\n}\n\nexport const EntriesPage = ({entries}: {entries: Entry[]}) => {\n  const [selectedIds, setSelectedIds] = useState<string[]>([]);\n\n  /**\n   * @event 선택 항목 토글\n   */\n  const handleSelectionToggle =\n    (entryId: string): MouseEventHandler<HTMLButtonElement> =>\n    () => {\n      setSelectedIds((currentSelectedIds) =>\n        currentSelectedIds.includes(entryId)\n          ? currentSelectedIds.filter(\n              (selectedId) => selectedId !== entryId,\n            )\n          : [...currentSelectedIds, entryId],\n      );\n    };\n\n  return (\n    <section>\n      <p>{selectedIds.length > 0 ? `${selectedIds.length} selected` : \"No selection\"}</p>\n      {entries.map((entry) => (\n        <button\n          key={entry.id}\n          onClick={handleSelectionToggle(entry.id)}\n        >\n          {entry.label}\n        </button>\n      ))}\n    </section>\n  );\n};\n",
        "afterSha256": "sha256:9d6c5700d7964ba3670c61dcc000705ec92e18383bedb24e3593315f70c2fe75"
      }
    ],
    "summary": "Replace derived selection state/effect synchronization with render-time calculation and move branching selection logic into a typed named handler that uses a functional updater."
