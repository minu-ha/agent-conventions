        "afterState": "present",
        "after": "import {useState} from \"react\";\n\ninterface Entry {\n  id: string;\n  label: string;\n}\n\nexport const EntriesPage = ({entries}: {entries: Entry[]}) => {\n  const [selectedIds, setSelectedIds] = useState<string[]>([]);\n\n  /** @event 항목 선택 상태 전환. */\n  const handleSelectionToggle = (entryId: string) => () => {\n    setSelectedIds((currentSelectedIds) =>\n      currentSelectedIds.includes(entryId)\n        ? currentSelectedIds.filter((selectedId) => selectedId !== entryId)\n        : [...currentSelectedIds, entryId],\n    );\n  };\n\n  return (\n    <section>\n      <p>\n        {selectedIds.length > 0\n          ? `${selectedIds.length} selected`\n          : \"No selection\"}\n      </p>\n      {entries.map((entry) => (\n        <button\n          key={entry.id}\n          onClick={handleSelectionToggle(entry.id)}\n        >\n          {entry.label}\n        </button>\n      ))}\n    </section>\n  );\n};\n",
        "afterSha256": "sha256:ac12e04abf98b40f7e5a474b8866252c6b64ae64794c20037ab418f148ea1506"
      }
    ],
    "summary": "Replace redundant selectedIds-derived state/effect synchronization with direct render reads and move the conditional toggle into a documented curried handler using a functional updater."
