        "after": "import {useState} from \"react\";\n\ninterface Entry {\n  id: string;\n  label: string;\n}\n\nexport const EntriesPage = ({entries}: {entries: Entry[]}) => {\n  const [selectedIds, setSelectedIds] = useState<string[]>([]);\n\n  /**\n   * @event entry 선택 상태 토글\n   */\n  const handleSelectionToggle = (entryId: string) => {\n    setSelectedIds((currentSelectedIds) =>\n      currentSelectedIds.includes(entryId)\n        ? currentSelectedIds.filter((selectedId) => selectedId !== entryId)\n        : [...currentSelectedIds, entryId],\n    );\n  };\n\n  return (\n    <section>\n      <p>{selectedIds.length > 0 ? `${selectedIds.length} selected` : \"No selection\"}</p>\n      {entries.map((entry) => (\n        <button\n          key={entry.id}\n          onClick={() => handleSelectionToggle(entry.id)}\n        >\n          {entry.label}\n        </button>\n      ))}\n    </section>\n  );\n};\n",
