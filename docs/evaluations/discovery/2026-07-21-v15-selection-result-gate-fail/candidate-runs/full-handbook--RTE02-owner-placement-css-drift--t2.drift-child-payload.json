        "after": "import clsx from \"clsx\";\nimport \"./entry-tree.css\";\n\n/**\n * @summary 엔트리 라우트 전용 트리 렌더러 속성 계약\n */\ninterface EntryTreeProps {\n  /**\n   * @field 트리에 표시할 엔트리 목록\n   */\n  entries: Array<{\n    /**\n     * @field 엔트리 식별자\n     */\n    id: string;\n    /**\n     * @field 트리에 표시할 엔트리 이름\n     */\n    label: string;\n  }>;\n  /**\n   * @field 선택된 엔트리 식별자\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul\n      className={clsx(\n        \"rt_entriesEntryTree__list\",\n        selectedId && \"rt_entriesEntryTree__list--selected\",\n      )}\n    >\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:2679c52bfe0a57a0f4872bb4cdc010a72bc678d63eed086938c62811d78666ac"
      },
      {
        "path": "src/routes/entries/-local/entry-tree.css",
