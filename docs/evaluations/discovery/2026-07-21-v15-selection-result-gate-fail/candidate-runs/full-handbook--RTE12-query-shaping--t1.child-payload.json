        "beforeSha256": "sha256:d4fb4cd10a6cf8d4185cb19a49a86a500e2bc9e48ef0faeb6f0cd04250d3d800",
        "afterState": "present",
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api entry 목록 조회 API\n   */\n  const responseEntriesQuery = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({\n        id: entry.id,\n        label: entry.title.trim(),\n      })),\n      meta: {total: response.total},\n    }),\n  });\n  /**\n   * @api entry 생성 API\n   */\n  const mutationEntryCreate = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntriesQuery.data.items}\n      total={responseEntriesQuery.data.meta.total}\n      onCreate={mutationEntryCreate.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:7c72717b514499041f8dad5b02440134da667334f0e4e55c1e274c273abe4520"
      }
    ],
    "summary": "entries/items/meta shaping을 query select에 모으고 response/mutation binding과 JSX 원본 체이닝을 정리한다."
  }
