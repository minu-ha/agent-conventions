        "after": "import clsx from \"clsx\";\n\n/**\n * @summary 엔트리 라우트 전용 트리 렌더러 속성 계약\n */\ninterface EntryTreeProps {\n  /**\n   * @field 트리에 표시할 엔트리 목록\n   */\n  entries: Array<{\n    /**\n     * @field 엔트리 식별자\n     */\n    id: string;\n    /**\n     * @field 트리에 표시할 엔트리 이름\n     */\n    label: string;\n  }>;\n  /**\n   * @field 선택된 엔트리 식별자\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:4d49126b1f2fd1be9c12df9b404d07f6dd1a88414b042312361164143776182b"
      }
    ],
