        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api entry 목록 응답을 렌더링용 데이터로 변환\n   */\n  const responseEntries = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({id: entry.id, label: entry.title.trim()})),\n      total: response.total,\n    }),\n  });\n  /**\n   * @api 새 entry 생성 요청\n   */\n  const mutationEntry = useMutation({mutationFn: postEntry});\n\n  return <EntryList items={responseEntries.data.items} total={responseEntries.data.total} onCreate={mutationEntry.mutate} />;\n};\n",
        "afterSha256": "sha256:f6e27a59361c361ad6d42a057ef894717ff843c9d50317e6786152eeb4ee924e"
      }
    ],
    "summary": "Shape entry list data in query select, keep response and mutation origins visible, and remove render-scope aliases."
