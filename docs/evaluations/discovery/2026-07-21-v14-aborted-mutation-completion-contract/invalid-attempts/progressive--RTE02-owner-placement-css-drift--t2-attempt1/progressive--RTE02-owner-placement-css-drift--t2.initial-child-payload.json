        "beforeSha256": null,
        "afterState": "present",
        "after": "import clsx from \"clsx\";\n\n/**\n * @summary 항목 경로 트리 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 표시할 항목 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 항목 ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:d24c6073d8abef35153bbf077578aae0edd4549535e2e5ebc36b64ce3ace3094"
      }
    ],
    "summary": "Route 전용 트리 렌더러를 shared UI에서 entries route의 -local 경계로 이동하고 Ui 접두사를 제거했다. 기존 clsx import와 className 문자열은 그대로 유지했다."
  },
