        "beforeSha256": null,
        "afterState": "present",
        "after": "import clsx from \"clsx\";\n\n/**\n * @summary route 전용 entry tree 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 렌더링할 entry 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 entry ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:26515bc6019259ce1b756a27d69aece466b20683573ea9d3ebe313bc0dfe47da"
      }
    ],
    "summary": "route 전용 tree renderer를 shared UI에서 entries route의 -local 경계로 옮기고 route-local 이름으로 변경하며 기존 className과 clsx import는 그대로 유지한다."
  },
