        "after": "import clsx from \"clsx\";\nimport \"./entry-tree.css\";\n\n/**\n * @summary route 전용 entry tree 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 렌더링할 entry 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 entry ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul\n      className={clsx(\n        \"rt_entriesEntryTree__tree\",\n        selectedId && \"rt_entriesEntryTree__tree--selected\",\n      )}\n    >\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:16f43fdb483e28dd46c44f054c78a93127e51c4eb34c2edbd754342db7bb7cab"
      },
      {
        "path": "src/routes/entries/-local/entry-tree.css",
        "beforeState": "absent",
        "beforeSha256": null,
        "afterState": "present",
        "after": ".rt_entriesEntryTree__tree {\n  list-style: none;\n}\n\n.rt_entriesEntryTree__tree--selected {\n  font-weight: 600;\n}\n",
        "afterSha256": "sha256:26fda903d458420b02cd50136afe9bdd771ba1acd198291b61079b9b8487cf88"
      }
    ],
    "summary": "route-local tree에 plain CSS를 직접 import하고 owner-unique rt_entriesEntryTree role classes를 clsx로 조합한다."
  },
