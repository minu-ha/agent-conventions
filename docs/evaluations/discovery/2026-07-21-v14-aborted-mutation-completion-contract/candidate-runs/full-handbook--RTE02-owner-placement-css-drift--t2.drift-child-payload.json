        "after": "import clsx from \"clsx\";\nimport \"./entry-tree.css\";\n\n/**\n * @summary 라우트 전용 엔트리 트리 속성 계약\n */\ninterface EntryTreeProps {\n  /**\n   * @field 렌더링할 엔트리 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 엔트리 ID\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul\n      className={clsx(\n        \"rt_entriesEntryTree__list\",\n        selectedId && \"rt_entriesEntryTree__list--selected\",\n      )}\n    >\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:4c5cec8d248c22ef641149133430c7454a2b8475b31efdb51e4ea55209265e33"
      },
