        "after": "import clsx from \"clsx\";\nimport \"./entry-tree.css\";\n\n/**\n * @summary 라우트 전용 엔트리 트리 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 렌더링할 엔트리 목록\n   */\n  entries: Array<{\n    /**\n     * @field 엔트리 식별자\n     */\n    id: string;\n    /**\n     * @field 엔트리 표시 이름\n     */\n    label: string;\n  }>;\n  /**\n   * @field 선택된 엔트리 식별자\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul\n      className={clsx(\n        \"rt_entriesEntryTree__list\",\n        selectedId && \"rt_entriesEntryTree__list--selected\",\n      )}\n    >\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:d7e78589d5534feb7affc2cee90bd75ce7700e3e028348588aab00a75a9f87c1"
      },
      {
        "path": "src/routes/entries/-local/entry-tree.css",
        "beforeState": "absent",
        "beforeSha256": null,
        "afterState": "present",
        "after": ".rt_entriesEntryTree__list {\n  list-style: none;\n}\n\n.rt_entriesEntryTree__list--selected {\n  font-weight: 600;\n}\n",
        "afterSha256": "sha256:3e58dbb0f4c0bee550226d4d0d163a94fae2c91206492d1dbcf93113fef27c88"
      }
    ],
