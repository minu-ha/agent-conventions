        "after": "import clsx from \"clsx\";\n\n/**\n * @summary 경로 전용 항목 트리 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 표시할 항목 목록\n   */\n  entries: Array<{id: string; label: string}>;\n  /**\n   * @field 선택된 항목 식별자\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:5e04d0d5a808466ba23ddcc5cead956359f4e819e91be066192b2d53c92a7e1a"
      }
    ],
