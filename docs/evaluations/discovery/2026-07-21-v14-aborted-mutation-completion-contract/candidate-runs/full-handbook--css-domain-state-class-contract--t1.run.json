  "virtualPatch": {
    "files": [
      {
        "after": "import { clsx } from \"clsx\";\nimport \"./_index.css\";\n\ninterface CatalogEntry {\n  id: string;\n  label: string;\n  active: boolean;\n}\n\nexport const CatalogPage = ({entries}: {entries: CatalogEntry[]}) => (\n  <nav className=\"route_catalog\">\n    {entries.map((entry) => (\n      <button\n        key={entry.id}\n        className={clsx(\n          \"route_catalog__listButton\",\n          entry.active && \"route_catalog__listButton--active\",\n        )}\n      >\n        {entry.label}\n      </button>\n    ))}\n  </nav>\n);\n",
        "afterSha256": "sha256:74d61f857abaa230cd456e7990417c8c31bfa1324f43203e62fec7b22b23d681",
        "afterState": "present",
        "beforeSha256": "sha256:abb019ed5a3c45ab86dfa1ffee120ac20468d10e0d9489ba5b237b9a8ef31d94",
        "beforeState": "present",
        "path": "src/routes/catalog/index.tsx"
      },
      {
        "after": ".route_catalog__listButton {\n  display: flex;\n}\n\n.route_catalog__listButton--active {\n  color: var(--color-accent);\n  font-weight: 700;\n}\n\n.route_catalog__listButton:hover {\n  text-decoration: underline;\n}\n",
        "afterSha256": "sha256:52de7301826413a93c60eac19faa401cd6021264d4f8ab11480a5bad94e78e92",
        "afterState": "present",
        "beforeSha256": "sha256:380447b980dedb2ae1260f1fb22e0ab14ddaf07d1a4a9a3a013e784501262bf7",
        "beforeState": "present",
        "path": "src/routes/catalog/_index.css"
      }
    ],
    "summary": "listButtonActive를 base와 --active modifier로 분리하고 clsx()로 조합하면서 hover pseudo-state 동작을 보존한다."
  }
