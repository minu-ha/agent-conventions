        "after": "import clsx from \"clsx\";\n\n/**\n * @summary 라우트 전용 엔트리 트리 속성\n */\ninterface EntryTreeProps {\n  /**\n   * @field 렌더링할 엔트리 목록\n   */\n  entries: Array<{\n    /**\n     * @field 엔트리 식별자\n     */\n    id: string;\n    /**\n     * @field 엔트리 표시 이름\n     */\n    label: string;\n  }>;\n  /**\n   * @field 선택된 엔트리 식별자\n   */\n  selectedId?: string;\n}\n\nexport const EntryTree = (props: EntryTreeProps) => {\n  const {entries, selectedId} = props;\n\n  return (\n    <ul className={clsx(\"ui_entryTree\", selectedId && \"ui_entryTree--selected\")}>\n      {entries.map((entry) => (\n        <li key={entry.id}>{entry.label}</li>\n      ))}\n    </ul>\n  );\n};\n",
        "afterSha256": "sha256:2bbcc194de2817fa3d6ad8bab430c2c5cd5d01d8e1a4246f16a00f64fbcda59b"
      }
