      {
        "path": "src/routes/entries/page.tsx",
        "beforeState": "present",
        "beforeSha256": "sha256:d4fb4cd10a6cf8d4185cb19a49a86a500e2bc9e48ef0faeb6f0cd04250d3d800",
        "afterState": "present",
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api entry 목록 조회 API\n   */\n  const responseEntries = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({id: entry.id, label: entry.title.trim()})),\n      meta: {total: response.total},\n    }),\n  });\n  /**\n   * @api entry 생성 API\n   */\n  const mutationCreateEntry = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntries.data.items}\n      total={responseEntries.data.meta.total}\n      onCreate={mutationCreateEntry.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:d7b0573c727e8978349677e2e2522a4fe572a14a79b714d44a515b4553d24212"
      }
    ],
    "summary": "렌더 단계의 entries/items/meta 가공을 query select로 이동하고 response/mutation binding과 원본 체이닝을 적용했다."
  }
