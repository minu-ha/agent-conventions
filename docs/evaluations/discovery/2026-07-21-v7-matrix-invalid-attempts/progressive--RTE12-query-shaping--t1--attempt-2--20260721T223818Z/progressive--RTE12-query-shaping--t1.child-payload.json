  "virtualPatch": {
    "files": [
      {
        "path": "src/routes/entries/page.tsx",
        "beforeState": "present",
        "beforeSha256": "sha256:d4fb4cd10a6cf8d4185cb19a49a86a500e2bc9e48ef0faeb6f0cd04250d3d800",
        "afterState": "present",
        "after": "import {useMutation, useSuspenseQuery} from \"@tanstack/react-query\";\n\nimport {EntryList} from \"./-local/entry-list\";\nimport {fetchEntries, postEntry} from \"./entry-api\";\n\nexport const EntriesPage = () => {\n  /**\n   * @api 엔트리 목록 조회\n   */\n  const responseEntries = useSuspenseQuery({\n    queryKey: [\"entries\"],\n    queryFn: fetchEntries,\n    select: (response) => ({\n      items: response.entries.map((entry) => ({id: entry.id, label: entry.title.trim()})),\n      meta: {total: response.total},\n    }),\n  });\n  /**\n   * @api 엔트리 생성\n   */\n  const mutationCreateEntry = useMutation({mutationFn: postEntry});\n\n  return (\n    <EntryList\n      items={responseEntries.data.items}\n      total={responseEntries.data.meta.total}\n      onCreate={mutationCreateEntry.mutate}\n    />\n  );\n};\n",
        "afterSha256": "sha256:3c8a205933e9659e5943ff5106d201bf23fa25959bb3c1228528d2361eb51722"
      }
    ],
    "summary": "렌더 단계의 entries/items/meta 가공을 query select로 옮기고 query/mutation 바인딩과 응답 소비 경로를 컨벤션에 맞게 정리했다."
  }
